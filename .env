RTMP_URL=rtmp://localhost:1935

# The default streaming edge (nginx-rtmp/vod, see streaming/). These fill in
# the 'default' entry of config/servers.php; further servers are added there
# directly. HLS_URL is the viewer-facing origin for /live and /videos-hls --
# left unset, those go through the web edge's transitional shims, which is what
# the dev stack does. Point it at the streaming host to exercise the split.
#HLS_URL=http://localhost:8081
STREAMING_HOST=streaming
STREAMING_RTMP_PORT=1935


LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
